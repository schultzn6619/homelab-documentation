# /etc/image-update-check.env (root:root, mode 600)
# Discord: channel settings > Integrations > Webhooks > New Webhook > Copy Webhook URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>
# Releases known to be bad, as container:tag, space separated
IGNORE_TAGS="livesync-cli:1.0.44-cli"

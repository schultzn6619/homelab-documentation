# /etc/discord-notify.env (root:root, mode 600). Shared by the failure alerts,
# the health check and the image update check.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>
# Your Discord user ID (Developer Mode, then right-click your name > Copy User ID)
DISCORD_PING_USER_ID=
# Units that are known to fail and should not alert (finding 12)
NOTIFY_IGNORE_UNITS="openipmi.service systemd-networkd-wait-online.service"
# Certificate check: the proxy's address and a hostname it serves
CERT_CHECK_ADDR=192.168.1.10
CERT_CHECK_HOST=npm.example.duckdns.org

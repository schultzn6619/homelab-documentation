[Unit]
Description=Wait (up to 2 min) for internet DNS before starting Docker
Before=docker.service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'until getent hosts registry-1.docker.io; do sleep 2; done'
RemainAfterExit=true
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
